{
	"name": "surfsense-website",
	"version": "2.0.0",
	"private": true,
	"packageManager": "pnpm@10.26.0",
	"engines": {
		"node": "24.x"
	},
	"description": "SurfSense's website at www.surfsense.com: the homepage, docs, blog, changelog, pricing and license pages, and the update feed and usage routes the desktop app calls",
	"scripts": {
		"dev": "next dev --turbopack",
		"dev:turbo": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "biome lint .",
		"format": "biome check --write ./ --max-diagnostics 500",
		"debug": "cross-env NODE_OPTIONS=--inspect next dev --turbopack",
		"debug:browser": "cross-env NODE_OPTIONS=--inspect next dev --turbopack",
		"debug:server": "cross-env NODE_OPTIONS=--inspect=0.0.0.0:9229 next dev --turbopack",
		"postinstall": "fumadocs-mdx",
		"typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
		"test:unit": "tsx --test \"app/**/*.test.ts\" \"features/**/*.test.ts\""
	},
	"dependencies": {
		"@hugeicons/core-free-icons": "^4.3.2",
		"@hugeicons/react": "^1.1.10",
		"@posthog/react": "^1.7.0",
		"@radix-ui/react-accordion": "^1.2.11",
		"@radix-ui/react-separator": "^1.1.7",
		"@radix-ui/react-slot": "^1.2.3",
		"@radix-ui/react-tabs": "^1.1.12",
		"@radix-ui/react-tooltip": "^1.2.7",
		"@types/mdx": "^2.0.13",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"fumadocs-core": "^16.3.1",
		"fumadocs-mdx": "^14.2.1",
		"fumadocs-ui": "^16.3.1",
		"fuzzy-search": "^3.2.1",
		"lenis": "^1.3.17",
		"motion": "^12.23.22",
		"next": "^16.3.6",
		"next-themes": "^0.4.6",
		"posthog-js": "^1.336.1",
		"posthog-node": "^5.24.4",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"server-only": "^0.0.1",
		"tailwind-merge": "^3.3.1",
		"tailwindcss-animate": "^1.0.7",
		"zod": "^4.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@playwright/test": "^1.59.1",
		"@svgr/webpack": "^8.1.0",
		"@tailwindcss/postcss": "^4.1.11",
		"@tailwindcss/typography": "^0.5.16",
		"@types/node": "^24",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"cross-env": "^7.0.3",
		"tailwindcss": "^4.1.11",
		"tsx": "^4.20.6",
		"typescript": "^5.8.3"
	}
}
