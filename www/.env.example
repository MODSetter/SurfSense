# ─────────────────────────────────────────────────────────────────────────────
# Backend
# ─────────────────────────────────────────────────────────────────────────────

# The license portal's origin: trial, resend and download on /downloads and
# /license. Production is https://api.surfsense.com.
NEXT_PUBLIC_FASTAPI_BACKEND_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────────────────────
# PostHog analytics (optional, leave key empty to disable)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-only. The desktop update feed and usage reports capture to this
# project; unset, they capture nothing.
DESKTOP_TELEMETRY_POSTHOG_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Global announcement banner, at the top of every page.
# Set ENABLED to "true" to show the banner, and put the notice text in MESSAGE.
# TONE is "info" (the site blue, the default) or "warning" (amber, for
# planned downtime / maintenance).
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GLOBAL_ANNOUNCEMENT_ENABLED=false
NEXT_PUBLIC_GLOBAL_ANNOUNCEMENT_MESSAGE=
NEXT_PUBLIC_GLOBAL_ANNOUNCEMENT_TONE=info

# ─────────────────────────────────────────────────────────────────────────────
# Announcement pill above the homepage headline. Set to "true" to show it.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_TOP_ANNOUNCEMENT_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# Stripe Payment Link (Individual licence)
# ─────────────────────────────────────────────────────────────────────────────
# The Buy a licence button on /pricing. NEXT_PUBLIC_* is baked in at
# `next build`, so a change here needs a rebuild (or a `next dev` restart).
# Leave empty to fall back to /contact.
NEXT_PUBLIC_STRIPE_LICENSE_INDIVIDUAL_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Business licence launch switch
# ─────────────────────────────────────────────────────────────────────────────
# "true" sells Business: /pricing shows Free, Business and Enterprise,
# /pricing/business exists and /pricing/individual redirects to it, the seven
# retired scrapers' plugin pages redirect to /plugins, and the trial and
# license pages describe the 14-day trial of the job. Anything else leaves the
# site as it was before Business. Set it on launch day and redeploy; the
# redirects are permanent, so do not set it earlier to preview on production.
NEXT_PUBLIC_BUSINESS_LAUNCHED=false

# The Business Stripe Payment Link: the Continue to checkout button on
# /pricing/business. A recurring yearly price, priced per person. Leave empty
# to fall back to /contact.
NEXT_PUBLIC_STRIPE_LICENSE_BUSINESS_URL=
