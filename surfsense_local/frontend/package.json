{
  "name": "surfsense-local-frontend",
  "private": true,
  "version": "2.0.2",
  "type": "module",
  "scripts": {
    "dev": "pnpm translations && vite",
    "translations": "formatjs compile-folder translations src/i18n/compiled --format simple --ast",
    "build": "pnpm translations && tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "pnpm translations && vitest run --environment jsdom",
    "typecheck": "pnpm translations && tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.3.0",
    "@assistant-ui/react": "^0.15.18",
    "@assistant-ui/react-streamdown": "^0.3.13",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@paper-design/shaders-react": "^0.0.80",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx-preview": "0.4.0",
    "exceljs": "^4.4.0",
    "katex": "^0.16.47",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "pdfjs-dist": "5.6.205",
    "radix-ui": "^1.6.7",
    "react": "^19.2.6",
    "react-data-grid": "7.0.0-beta.61",
    "react-dom": "^19.2.6",
    "react-intl": "12.1.3",
    "shadcn": "^4.20.1",
    "sonner": "^2.0.8",
    "ssf": "^0.11.2",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@formatjs/cli": "6.16.32",
    "@testing-library/react": "^16.3.3",
