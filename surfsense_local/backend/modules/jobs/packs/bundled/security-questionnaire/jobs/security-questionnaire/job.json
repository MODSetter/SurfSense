    "comment": "\\b(documents?|passages?|sources?|quotes?)\\b[^.]{0,40}\\b(do|does|did)\\s+not\\s+(state|mention|describe|specify|address|say|indicate|show)|\\bno passage\\b",
    "suggest": [
      "N/A"
    ],
    "provider": "\\b(managed by|hosted by|operated by|run by|provided by|providers?)\\b",
    "provider_setting": "provider_na",
    "check": "prompts/suggestion_check.md"
