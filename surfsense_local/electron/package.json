{
  "name": "surfsense-local-electron",
  "productName": "SurfSense",
  "private": true,
  "packageManager": "pnpm@11.27.1",
  "version": "2.0.3",
  "description": "Electron shell: spawns the API + worker sidecars, loads the Vite SPA",
  "author": {
    "name": "SurfSense",
    "email": "noreply@surfsense.app"
  },
  "homepage": "https://github.com/MODSetter/SurfSense",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "predev": "pnpm build:model && pnpm build:voice && pnpm build:parser && pnpm build:llamacpp && pnpm build:sdcpp && pnpm build:audiocpp",
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"pnpm --dir ../frontend dev\" \"wait-on tcp:127.0.0.1:5173 && node scripts/electron-dev.mjs\"",
    "build": "electron-vite build",
    "build:frontend": "pnpm --dir ../frontend install && pnpm --dir ../frontend build",
    "build:binaries": "uv --directory ../backend run scripts/build_binaries.py",
    "build:model": "uv --directory ../backend run scripts/fetch_embedding_model.py models",
    "build:voice": "uv --directory ../backend run scripts/fetch_bundled_voice.py models",
    "build:parser": "uv --directory ../backend run scripts/fetch_docling_models.py models",
    "build:llamacpp": "node scripts/fetch-llamacpp.mjs",
    "build:sdcpp": "node scripts/sdcpp/stage.mjs",
    "build:audiocpp": "node scripts/audiocpp/stage.mjs",
    "dist": "pnpm build:llamacpp && pnpm build:sdcpp --strict && pnpm build:audiocpp --strict && pnpm build:frontend && pnpm build:binaries && pnpm build:model && pnpm build:voice && pnpm build:parser && pnpm build && electron-builder",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/main/*.test.ts src/main/**/*.test.ts scripts/**/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:sidecars": "node scripts/check-sidecars.mjs"
  },
  "devDependencies": {
    "@types/node": "^24",
    "concurrently": "^10",
    "electron": "^44",
    "electron-builder": "^26.16.1",
    "electron-vite": "^5",
    "typescript": "~6",
    "vite": "^7",
    "wait-on": "^9"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
