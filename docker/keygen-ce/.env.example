# Copy to .env and fill in. .env is gitignored.
#
# Generate the five values:
#
#   bash:
#     openssl rand -hex 64                        -> SECRET_KEY_BASE
#     openssl rand -base64 32                     -> each ENCRYPTION_* value
#     uuidgen | tr '[:upper:]' '[:lower:]'        -> KEYGEN_ACCOUNT_ID
#
#   PowerShell:
#     $b=New-Object byte[] 64; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#     -join ($b | % { $_.ToString("x2") })        -> SECRET_KEY_BASE
#     [Convert]::ToBase64String($b[0..31])        -> each ENCRYPTION_* value (re-randomise each)
#     [guid]::NewGuid().ToString().ToLower()      -> KEYGEN_ACCOUNT_ID
#
# All four secrets are required by `setup`, not just SECRET_KEY_BASE.

SECRET_KEY_BASE=
ENCRYPTION_DETERMINISTIC_KEY=
ENCRYPTION_PRIMARY_KEY=
ENCRYPTION_KEY_DERIVATION_SALT=

# Generated by us in singleplayer mode, not assigned by Keygen. Must be lowercase.
KEYGEN_ACCOUNT_ID=

# Supplying these two lets `setup` run without a TTY.
KEYGEN_ADMIN_EMAIL=admin@surfsense.local
KEYGEN_ADMIN_PASSWORD=

KEYGEN_EDITION=CE
KEYGEN_MODE=singleplayer

# MUST be a dotted name with a parseable eTLD+1. A single label such as
# `localhost` or a bare compose service name crashes boot -- see README trap 2.
KEYGEN_HOST=api.keygen.localhost

DATABASE_URL=postgres://keygen:keygen@db:5432/keygen
REDIS_URL=redis://redis:6379
