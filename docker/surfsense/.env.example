# =============================================================================
# SurfSense in Docker: settings for docker-compose.yml
# =============================================================================
# Copy to .env beside docker-compose.yml. Every value is optional.

# The image tag: a version such as 2.4.0, or latest.
SURFSENSE_VERSION=latest
# Leave empty for the CPU image.
SURFSENSE_VARIANT=

# Where the app answers: http://<this server's address>:4929 from any device on
# its network, or http://localhost:4929 on the server itself.
SURFSENSE_PORT=4929

# -----------------------------------------------------------------------------
# Signing in
# -----------------------------------------------------------------------------
# SurfSense always asks for a password. The first time it is opened, from any
# browser, it asks to create one. The log says so while none exists.
#
# Or set it here, before the first start, on a server reachable from the
# internet, such as a VPS: Docker's published ports pass the server's firewall
# (ufw included), so whoever reaches a fresh instance first would set it. Set here, it is applied at every start, which also resets a forgotten
# one, and the app shows it locked: change it here. Remove it and restart to
# manage the password in the app instead; the current one stays.
SURFSENSE_PASSWORD=
# Whether SurfSense asks for a password. One of:
#   (empty)  Ask. The default: a password is set up on first visit, then
#            every device signs in with it.
#   none     Never ask. Anyone who can reach SurfSense can use it: your
#            documents, chats, plugins and API keys. Use it only when
#            something else decides who reaches it: this machine alone
#            (SURFSENSE_BIND=127.0.0.1), a VPN such as Tailscale, or a
#            proxy with its own login such as Cloudflare Access or Authelia.
#            Name your addresses in SURFSENSE_ALLOWED_HOSTS too: without a
#            password, that is what stops a web page rebinding its own name
#            to SurfSense. The log warns at every start.
# Any other value stops SurfSense at start.
SURFSENSE_AUTH=

# -----------------------------------------------------------------------------
# Opening it to other devices
# -----------------------------------------------------------------------------
# Which addresses to publish on: 0.0.0.0, the default, is every network the
# server is on, so phones and laptops reach it; 127.0.0.1 is this machine only.
SURFSENSE_BIND=0.0.0.0
# The host names or addresses it answers on, comma-separated, such as
# surfsense.lan,192.168.1.20. Empty: any. Any other name is refused, which stops
# a web page rebinding its own name to this address.
SURFSENSE_ALLOWED_HOSTS=

# -----------------------------------------------------------------------------
# HTTPS, for every device but this machine
# -----------------------------------------------------------------------------
# Without it, a password and a session cookie cross the network in the clear,
# and browsers allow the microphone only on this machine. Pick one:
#
# On a LAN: SURFSENSE_TLS=internal issues certificates for each name in
# SURFSENSE_ALLOWED_HOSTS from the container's own certificate authority. Each
# device trusts its root once: copy it out with
#   docker compose cp surfsense:/data/home/.local/share/caddy/pki/authorities/local/root.crt .
SURFSENSE_TLS=
# On the internet: a domain that resolves to this machine gets a certificate
# from Let's Encrypt. Set SURFSENSE_PORT=80 and SURFSENSE_HTTPS_PORT=443 so the
# certificate authority can reach it.
SURFSENSE_DOMAIN=
# The published HTTPS port.
SURFSENSE_HTTPS_PORT=4943

# The secret that encrypts stored provider keys. Empty: one is created in the
# data volume on the first start and kept there. Set it to keep it outside the
# volume; changing it later makes stored keys unreadable.
SURFSENSE_SECRET=

# Another registry or a local build, such as surfsense with SURFSENSE_VERSION=dev.
SURFSENSE_IMAGE=ghcr.io/modsetter/surfsense
