# The plugin host's settings. On Azure Container Apps they are the container's
# environment variables, with each secret a Key Vault reference; locally, copy this
# file to host/.env and run from plugins/remote/:
#   uv run --project host --env-file host/.env python -m host
# The license check needs no setting: Keygen's address and SurfSense's account id
# are constants in proprietary/license_check/keygen.py.

# --- The host ---

# The port it serves on. Container Apps' ingress points at this one.
PORT=8000

# The plugins this container serves, ids separated by commas. Unset, it serves
# every plugin in the image; set, it is a plugin split into a container of its own.
# PLUGINS=reddit

# Where a Stop is passed to the other copies of the host, and later jobs, rate
# limits and the license cache. Unset, a Stop reaches only this copy, so set it
# whenever more than one copy runs.
REDIS_URL=redis://localhost:6379/0

# --- What the scraper plugins share (proprietary/scraping/config.py) ---

# Which provider reads the proxy URLs below: custom, dataimpulse or nodemaven.
SCRAPING_PROXY_PROVIDER=custom

# A secret: one full residential proxy endpoint, with its user and password.
# Unset, scrapes go direct from the container's own address, which sites block.
#   dataimpulse puts the country in the user as "__cr.<country>",
#   nodemaven as "-country-<country>". Reddit and TikTok rotate countries themselves.
# SCRAPING_PROXY_URL=http://user:pass@host:port  # pragma: allowlist secret

# A secret: endpoints separated by commas, which the custom provider rotates
# through. Server-side rotating gateways ignore it.
# SCRAPING_PROXY_URLS=http://user:pass@host1:port,http://user:pass@host2:port  # pragma: allowlist secret
