# Read beside the Dockerfile; the build context is plugins/.
# Only remote/ goes in; the deferred bundles never ship in the plugin host.
bundles/

# No tests, sample plugins or local state in the image.
**/tests/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.env
**/.DS_Store
# The usage meter's file from a local run.
remote/usage/
